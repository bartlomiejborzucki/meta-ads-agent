# ---------------------------------------------------------------------------
# meta-ads-agent — OPTIONAL Marketing API fallback configuration
# ---------------------------------------------------------------------------
#
# You do NOT need this file for normal use.
#
# The default execution layer is Meta's official Ads MCP server, which
# authenticates through your browser with Meta OAuth. If everything you do is
# covered by that server, you never need a token, an app, or this file.
#
# These values are only read by `meta-ads-agent api ...` commands, which exist
# to fill specific gaps in the official MCP — today that is local image and
# video upload, video / existing-post / multi-variant creatives, and deletion.
# Run `meta-ads-agent capabilities` to see the current list.
#
# Set up: cp .env.example .env  and fill in what you need.
# `.env` is gitignored. Never commit it. Never paste a token into a chat.
# ---------------------------------------------------------------------------

# Required for any `api` subcommand. A user or system-user access token with
# ads_management on the target account.
META_ACCESS_TOKEN=

# Required only for flows that need app credentials (for example exchanging a
# short-lived token for a long-lived one). Plain ads writes do not need them.
META_APP_ID=
META_APP_SECRET=

# Convenience default so you can omit --account on every command.
# Format: act_<numeric id>
META_AD_ACCOUNT_ID=

# Graph API version used by the fallback. Defaults to the version this release
# was tested against; override to move ahead of or behind our default.
# See docs/reference/api-versioning.md before changing it.
META_GRAPH_API_VERSION=v26.0

# Where the brand workspace lives. Defaults to ./.meta-ads in the current
# project. Set this to share one workspace across several checkouts.
META_ADS_WORKSPACE=
